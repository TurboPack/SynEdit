package SynEditFMXDR;

{$R *.res}
{$IFDEF IMPLICITBUILDING This IFDEF should not be used by users}
{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST ON}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DEFINE RELEASE}
{$ENDIF IMPLICITBUILDING}
{$DESCRIPTION 'TurboPack SynEdit Delphi FMX runtime package'}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD OFF}

requires
  fmx,
  rtl,
  SynEditSharedDR;

contains
  FMX.SynCompletionProposal in '..\..\..\Source\FMX\FMX.SynCompletionProposal.pas',
  FMX.SynEdit in '..\..\..\Source\FMX\FMX.SynEdit.pas',
  FMX.SynEditDragDrop in '..\..\..\Source\FMX\FMX.SynEditDragDrop.pas',
  FMX.SynEditKbdHandler in '..\..\..\Source\FMX\FMX.SynEditKbdHandler.pas',
  FMX.SynEditKeyConst in '..\..\..\Source\FMX\FMX.SynEditKeyConst.pas',
  FMX.SynEditMiscClasses in '..\..\..\Source\FMX\FMX.SynEditMiscClasses.pas',
  FMX.SynEditPlugins in '..\..\..\Source\FMX\FMX.SynEditPlugins.pas',
  FMX.SynEditPrint in '..\..\..\Source\FMX\FMX.SynEditPrint.pas',
  FMX.SynEditPrinterInfo in '..\..\..\Source\FMX\FMX.SynEditPrinterInfo.pas',
  FMX.SynEditPrintHeaderFooter in '..\..\..\Source\FMX\FMX.SynEditPrintHeaderFooter.pas',
  FMX.SynEditPrintMargins in '..\..\..\Source\FMX\FMX.SynEditPrintMargins.pas',
  FMX.SynEditPrintTypes in '..\..\..\Source\FMX\FMX.SynEditPrintTypes.pas',
  FMX.SynEditRenderer in '..\..\..\Source\FMX\FMX.SynEditRenderer.pas',
  FMX.SynEditScrollBars in '..\..\..\Source\FMX\FMX.SynEditScrollBars.pas',
  FMX.SynEditScrollTypes in '..\..\..\Source\FMX\FMX.SynEditScrollTypes.pas',
  FMX.SynEditUndo in '..\..\..\Source\FMX\FMX.SynEditUndo.pas',
  FMX.SynEditWordWrap in '..\..\..\Source\FMX\FMX.SynEditWordWrap.pas',
  FMX.SynMacroRecorder in '..\..\..\Source\FMX\FMX.SynMacroRecorder.pas',
  FMX.SynSpellCheck in '..\..\..\Source\FMX\FMX.SynSpellCheck.pas',
  FMX.SynUnicode in '..\..\..\Source\FMX\FMX.SynUnicode.pas',
  SynSpellCheckHunspellProvider in '..\..\..\Source\SynSpellCheckHunspellProvider.pas',
  SynSpellCheckTypes in '..\..\..\Source\SynSpellCheckTypes.pas',
  SynSpellCheckWinAPI in '..\..\..\Source\SynSpellCheckWinAPI.pas',
  SynSpellCheckWindowsProvider in '..\..\..\Source\SynSpellCheckWindowsProvider.pas';

end.
